pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        LAB2_DIR = "${WORKSPACE}/lab2"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                sh '''
                    python3 -m pip install --upgrade pip
                    python3 -m pip install -r lab2/requirements.txt
                '''
            }
        }

        stage('Fetch data') {
            steps {
                sh 'cd lab2 && python3 scripts/fetch_data.py'
            }
        }

        stage('Preprocess') {
            steps {
                sh 'cd lab2 && python3 scripts/preprocess_data.py'
            }
        }

        stage('Train model') {
            steps {
                sh 'cd lab2 && python3 scripts/train_model.py'
            }
        }

        stage('Evaluate model') {
            steps {
                sh 'cd lab2 && python3 scripts/evaluate_model.py'
            }
        }
    }

    post {
        success {
            echo 'Конвейер lab2 завершён успешно.'
        }
        failure {
            echo 'Конвейер lab2 завершился с ошибкой.'
        }
    }
}
